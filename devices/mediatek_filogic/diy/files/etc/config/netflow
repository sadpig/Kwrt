config netflow 'config'
	option enable '0'
	option config_path '/etc/netflow/config.yaml'
	option config_dir '/etc/netflow/config'
	option mihomo_path '/etc/netflow/mihomo/mihomo'
	option api_port '9091'
	option api_secret 'netflow_secret'
	option backend_port '9190'
	option redir_port '7892'
	option dns_port '7874'
	option mixed_port '7890'
	option proxy_mode 'rule'
	option run_mode 'fake-ip'
	option tun_enabled '0'
	option lan_proxy '1'
	option ipv6_proxy '0'
	option oss_url 'https://osskehu.oss-cn-shanghai.aliyuncs.com/ConFigOss.json,https://osskehu.oss-cn-shanghai.aliyuncs.com/ConFigOss.json'

config v2board 'v2board'
	option api_url ''
	option email ''
	option token ''
	option auto_subscribe '1'
	option last_login_time ''
	option last_subscribe_time ''
